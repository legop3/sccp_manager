{
  "id": "catdog",
  "name": "catdog",
  "description": "send cat or dog pictures with configurable cooldown and delivery",
  "enabledByDefault": false,
  "settings": {
    "cooldown_minutes": {
      "type": "integer",
      "label": "cooldown per user (minutes)",
      "default": 60,
      "min": 1,
      "max": 1440
    },
    "allow_cats": {
      "type": "toggle",
      "label": "allow cats",
      "default": true
    },
    "allow_dogs": {
      "type": "toggle",
      "label": "allow dogs",
      "default": true
    },
    "delivery": {
      "type": "select",
      "label": "image delivery",
      "default": "all",
      "options": {
        "all": "all connected phones",
        "self": "only requesting phone"
      }
    }
  }
}
