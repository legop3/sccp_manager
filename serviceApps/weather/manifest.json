{
  "id": "weather",
  "name": "weather",
  "description": "built-in weather service",
  "enabledByDefault": true,
  "builtin": true,
  "order": 10,
  "settings": {
    "name": {
      "type": "text",
      "label": "location name",
      "default": "columbus, oh",
      "minLength": 1,
      "maxLength": 64
    },
    "lat": {
      "type": "number",
      "label": "latitude",
      "default": 39.9612,
      "min": -90,
      "max": 90,
      "step": 0.0001
    },
    "lon": {
      "type": "number",
      "label": "longitude",
      "default": -82.9988,
      "min": -180,
      "max": 180,
      "step": 0.0001
    }
  }
}
