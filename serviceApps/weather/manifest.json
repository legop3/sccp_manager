{
  "id": "weather",
  "name": "Weather",
  "description": "Built-in Weather service",
  "enabledByDefault": true,
  "builtin": true,
  "order": 10,
  "settings": {
    "name": {
      "type": "text",
      "label": "Location name",
      "default": "Columbus, OH",
      "minLength": 1,
      "maxLength": 64
    },
    "lat": {
      "type": "number",
      "label": "Latitude",
      "default": 39.9612,
      "min": -90,
      "max": 90,
      "step": 0.0001
    },
    "lon": {
      "type": "number",
      "label": "Longitude",
      "default": -82.9988,
      "min": -180,
      "max": 180,
      "step": 0.0001
    }
  }
}
