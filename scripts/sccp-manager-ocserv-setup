#!/usr/bin/env python3
"""Private SCCP Manager ocserv setup engine, invoked only by the installed root helper.

Receives a small validated JSON object on stdin. Never executes user-supplied
paths or shell commands. Owns /etc/ocserv/sccp-manager.conf, not a vendor or
user-managed /etc/ocserv/ocserv.conf.
"""
import ipaddress
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from urllib.parse import urlsplit

ROOT = Path("/etc/ocserv")
CONFIG = ROOT / "sccp-manager.conf"
CERT = ROOT / "server-cert.pem"
KEY = ROOT / "server-key.pem"
PASSWD = ROOT / "ocpasswd"
UNIT = "sccp-ocserv.service"


def run(argv, **kwargs):
    return subprocess.run(argv, check=True, capture_output=True, text=True, **kwargs)


def binary():
    for path in ("/usr/local/sbin/ocserv", "/usr/sbin/ocserv"):
        if Path(path).is_file() and os.access(path, os.X_OK):
            return path
    raise RuntimeError("ocserv is not installed; rerun the root-level SCCP Manager module upgrade")


def validate(options):
    if not isinstance(options, dict) or set(options) != {
        "gateway", "pbx_ip", "vpn_subnet", "udp_port", "max_same_clients"
    }:
        raise ValueError("Unexpected VPN setup options")
    uri = urlsplit(options["gateway"])
    if uri.scheme != "https" or uri.path != "/svc" or uri.query or uri.fragment:
        raise ValueError("Cisco VPN URI must look like https://host:4443/svc")
    if not uri.hostname or uri.username or uri.password:
        raise ValueError("VPN hostname is missing or contains credentials")
    hostname = uri.hostname
    try:
        ipaddress.ip_address(hostname)
    except ValueError:
        if len(hostname) > 253 or not re.fullmatch(
            r"(?=.{1,253}\Z)[A-Za-z0-9]+(?:[A-Za-z0-9.-]*[A-Za-z0-9])?", hostname
        ) or any(len(x) > 63 or not x or x[0] == "-" or x[-1] == "-" for x in hostname.split(".")):
            raise ValueError("Invalid VPN hostname")
    if uri.port is None or not 1 <= uri.port <= 65535:
        raise ValueError("VPN gateway URL must contain an explicit TCP port")
    udp = options["udp_port"]
    shared = options["max_same_clients"]
    if type(udp) is not int or not 1 <= udp <= 65535:
        raise ValueError("Invalid VPN UDP port")
    if type(shared) is not int or not 0 <= shared <= 1000:
        raise ValueError("Invalid maximum shared login session count")
    ip = ipaddress.IPv4Address(options["pbx_ip"])
    if not ip.is_private or ip.is_multicast or ip.is_loopback or ip.is_unspecified:
        raise ValueError("PBX address must be a private LAN IPv4 address")
    subnet = ipaddress.IPv4Network(options["vpn_subnet"], strict=True)
    if not subnet.is_private or subnet.prefixlen < 16 or subnet.prefixlen > 28:
        raise ValueError("VPN pool must be a private IPv4 network, prefix /16 through /28")
    if ip in subnet:
        raise ValueError("VPN pool must not overlap the PBX LAN address")
    return {
        "hostname": hostname,
        "tcp": uri.port,
        "udp": udp,
        "pbx_ip": str(ip),
        "subnet": subnet,
        "shared": shared,
    }


def create_certificate(hostname):
    if CERT.is_symlink() or KEY.is_symlink():
        raise RuntimeError("Cannot use symlinked server certificate or private key")
    if CERT.exists() != KEY.exists():
        raise RuntimeError("Existing TLS certificate/key pair is incomplete; restore the matching original pair")
    if CERT.exists():
        return False
    with tempfile.TemporaryDirectory(prefix=".sccp-tls-", dir=str(ROOT)) as tmp:
        cert = Path(tmp) / "cert.pem"
        key = Path(tmp) / "key.pem"
        try:
            ipaddress.ip_address(hostname)
            san = "IP:" + hostname
        except ValueError:
            san = "DNS:" + hostname
        run(["/usr/bin/openssl", "req", "-x509", "-newkey", "rsa:2048",
             "-sha256", "-nodes", "-days", "3650",
             "-subj", "/CN=" + hostname, "-addext", "subjectAltName=" + san,
             "-keyout", str(key), "-out", str(cert)])
        os.chmod(key, 0o600)
        os.chmod(cert, 0o644)
        os.replace(key, KEY)
        os.replace(cert, CERT)
    return True


def render(values):
    return (
        "# Managed by FreePBX SCCP Manager. Do not edit this file by hand.\n"
        "auth = \"plain[passwd=/etc/ocserv/ocpasswd]\"\n"
        "run-as-user = nobody\n"
        "run-as-group = nogroup\n"
        "socket-file = /run/sccp-ocserv-socket\n"
        "device = vpns\n"
        "server-cert = /etc/ocserv/server-cert.pem\n"
        "server-key = /etc/ocserv/server-key.pem\n"
        "tcp-port = {tcp}\n"
        "udp-port = {udp}\n"
        "max-clients = 100\n"
        "max-same-clients = {shared}\n"
        "ipv4-network = {network}\n"
        "ipv4-netmask = {mask}\n"
        "route = {pbx_ip}/255.255.255.255\n"
        "cisco-client-compat = true\n"
        "dtls-legacy = true\n"
        "keepalive = 32400\n"
        "dpd = 90\n"
        "mobile-dpd = 180\n"
        "try-mtu-discovery = false\n"
    ).format(tcp=values["tcp"], udp=values["udp"],
             shared=values["shared"], network=values["subnet"].network_address,
             mask=values["subnet"].netmask, pbx_ip=values["pbx_ip"])


def configure(raw):
    values = validate(raw)
    if not ROOT.is_dir() or ROOT.is_symlink():
        raise RuntimeError("/etc/ocserv is missing or is a symlink")
    if CONFIG.is_symlink() or PASSWD.is_symlink():
        raise RuntimeError("Unsafe existing VPN configuration/password file")
    # A manually launched ocserv instance can occupy the requested port.
    # Never kill it; the admin must stop it before enabling this service.
    active = subprocess.run(["/usr/bin/systemctl", "is-active", "--quiet", UNIT],
                            check=False).returncode == 0
    if not active and subprocess.run(["/usr/bin/pgrep", "-x", "ocserv"],
                                     capture_output=True, check=False).returncode == 0:
        raise RuntimeError("Another ocserv is running. Stop the old instance before activating SCCP Manager VPN")
    os.chmod(ROOT, 0o755)
    created = create_certificate(values["hostname"])
    if not PASSWD.exists():
        fd = os.open(PASSWD, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        os.close(fd)
    payload = render(values).encode("utf-8")
    old = CONFIG.read_bytes() if CONFIG.is_file() else None
    if old == payload and active:
        return {"changed": False, "service": "active"}
    with tempfile.NamedTemporaryFile(dir=str(ROOT), prefix=".sccp-config-", delete=False) as tmp:
        temp_file = Path(tmp.name)
        tmp.write(payload)
    try:
        os.chmod(temp_file, 0o600)
        run([binary(), "-t", "-c", str(temp_file)])
        # Preserve any old live configuration if parsing fails.
        os.replace(temp_file, CONFIG)
    finally:
        if temp_file.exists():
            temp_file.unlink()
    # Upgrade the earlier SCCP Manager unit (which launched ocserv.conf).
    # Only touch our own identifiable systemd unit, not another VPN unit.
    unit_path = Path("/etc/systemd/system/sccp-ocserv.service")
    if unit_path.is_file() and unit_path.read_text().find("/etc/ocserv/sccp-manager.conf") == -1:
        old_unit = unit_path.read_text()
        if "SCCP Manager" not in old_unit:
            raise RuntimeError("Conflicting systemd unit is not owned by SCCP Manager")
        for line in old_unit.splitlines():
            if line.startswith("ExecStart="):
                old_unit = old_unit.replace(line,
                    "ExecStart=" + binary() + " -f -c /etc/ocserv/sccp-manager.conf")
                break
        unit_path.write_text(old_unit)
        os.chmod(unit_path, 0o644)
    run(["/usr/bin/systemctl", "daemon-reload"])
    run(["/usr/bin/systemctl", "enable", UNIT])
    run(["/usr/bin/systemctl", "restart" if active else "start", UNIT])
    if subprocess.run(["/usr/bin/systemctl", "is-active", "--quiet", UNIT],
                      check=False).returncode != 0:
        raise RuntimeError("Managed VPN service did not remain active; check systemctl status sccp-ocserv")
    return {"changed": True, "certificate_created": created, "service": "active"}


def main():
    if os.geteuid() != 0:
        raise PermissionError("Root required")
    blob = sys.stdin.buffer.read(4097)
    if len(blob) > 4096:
        raise ValueError("VPN configuration request is too large")
    print(json.dumps(configure(json.loads(blob.decode("utf-8")))))


if __name__ == "__main__":
    try:
        main()
    except (ValueError, TypeError, OSError, RuntimeError, subprocess.CalledProcessError) as err:
        print("SCCP VPN configuration failed:", err, file=sys.stderr)
        sys.exit(1)
