#!/usr/bin/env python3
"""Restricted root helper for SCCP Manager's Cisco VPN provisioning.

Installed root-owned by scripts/install-vpn-helper.sh. The FreePBX process can
run it through a narrowly scoped sudoers entry. No caller-supplied paths are
accepted: sign accepts only an exact Cisco SEP<12 hex> identity.
"""
import base64
import hashlib
import json
import os
import pwd
from pathlib import Path
import stat
import re
import shutil
import ssl
import subprocess
import sys
import tempfile

TFTP = Path("/tftpboot")
MANAGED_CONFIG = Path("/etc/ocserv/sccp-manager.conf")
MANAGED_SETUP = "/usr/local/libexec/sccp-manager-ocserv-setup"
KEY_DIR = Path("/etc/cisco-signing")
VPN_CERT = Path("/etc/ocserv/server-cert.pem")
BIN_DIR = Path("/usr/local/libexec/sccp-manager-vpn")
SYSTEMD_SERVICE = "sccp-ocserv.service"
ACCOUNT_PATH = Path("/etc/ocserv/ocpasswd")
OCCTL_SOCKET = "/run/sccp-ocserv-socket"
DEVICE = re.compile(r"SEP[0-9A-F]{12}\Z")


def run(argv):
    return subprocess.run(argv, check=True, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, text=True)


def certificate_digest(pem_path):
    pem = pem_path.read_text(encoding="ascii")
    match = re.search(r"-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----",
                      pem, re.DOTALL)
    if not match:
        raise RuntimeError("No certificate in " + str(pem_path))
    der = ssl.PEM_cert_to_DER_cert(match.group(0))
    return hashlib.sha1(der).digest()


def certificate_hash():
    # The Cisco vpnGroup certHash1 uses SHA1 over the DER-encoded TLS certificate.
    print(base64.b64encode(certificate_digest(VPN_CERT)).decode("ascii"))


def validate_paths(device, source_dir=""):
    if not DEVICE.fullmatch(device):
        raise ValueError("Expected SEP and exactly 12 uppercase hexadecimal digits")
    # Only allow a direct child of the TFTP root as the generator's source.
    # No absolute paths, traversal, nested directories, or symlinks.
    if source_dir and not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", source_dir):
        raise ValueError("Invalid relative TFTP configuration directory")
    if not TFTP.is_dir() or TFTP.is_symlink():
        raise RuntimeError("Unexpected TFTP root")
    directory = TFTP / source_dir if source_dir else TFTP
    if not directory.is_dir() or directory.is_symlink():
        raise RuntimeError("Missing or unsafe TFTP configuration directory")
    xml = directory / (device + ".cnf.xml")
    if not xml.is_file() or xml.is_symlink():
        raise RuntimeError("Missing or unsafe phone XML: " + str(xml))
    return xml


def verify_trust(cert_path, trust_file):
    output = run([str(BIN_DIR / "tlvfile"), "--parse", str(trust_file)]).stdout
    # certutils prints roles and SHA1 certificate hashes for each record.
    digest = certificate_digest(cert_path).hex()
    if not re.search(r"Role:\s+TFTP\b(?:(?!Role:).)*?Certificate Hash:\s+" +
                     re.escape(digest), output, re.DOTALL | re.IGNORECASE):
        raise RuntimeError("Existing ITL does not contain the configured TFTP certificate; refusing to replace it")


def sign(device, source_dir=""):
    xml = validate_paths(device, source_dir)
    signer_cert = KEY_DIR / "tftp.pem"
    sast_cert = KEY_DIR / "sast.pem"
    for key in (signer_cert, sast_cert):
        if not key.is_file() or key.is_symlink():
            raise RuntimeError("Missing/unsafe signing certificate: " + str(key))
    itl = TFTP / ("ITL" + device + ".tlv")
    target = TFTP / (device + ".cnf.xml.sgn")
    if itl.is_symlink() or target.is_symlink():
        raise RuntimeError("Refusing to overwrite a symlinked provisioning file")
    if itl.is_file():
        verify_trust(signer_cert, itl)

    # Build outside public TFTP, then publish complete files via rename.
    # Temporary directory must be on the same filesystem to allow os.replace.
    # Restrict mode so private key material never becomes public.
    with tempfile.TemporaryDirectory(prefix=".sccp-vpn-", dir=str(TFTP)) as tmp:
        directory = Path(tmp)
        source = directory / xml.name
        shutil.copyfile(xml, source)
        signed = directory / (xml.name + ".sgn")
        run([str(BIN_DIR / "sgnfile"), "--build", str(source),
             "--tftp", str(signer_cert)])
        if not signed.is_file() or signed.stat().st_size == 0:
            raise RuntimeError("sgnfile did not generate an output")
        output = run([str(BIN_DIR / "sgnfile"), "--parse", str(signed),
                      "--tftp", str(signer_cert)]).stdout
        if "Valid signature" not in output:
            raise RuntimeError("Signed output did not pass verification")

        if not itl.is_file():
            temp_itl = directory / itl.name
            run([str(BIN_DIR / "tlvfile"), "--build", str(temp_itl),
                 "--filename", "ITLFile.tlv", "--sast", str(sast_cert),
                 "--tftp", str(signer_cert)])
            if not temp_itl.is_file() or temp_itl.stat().st_size == 0:
                raise RuntimeError("tlvfile did not produce an output")
            verify_trust(signer_cert, temp_itl)
            os.chmod(temp_itl, 0o644)
            os.replace(temp_itl, itl)

        # The module's normal store may be /tftpboot/settings, but Cisco
        # phones request SEP...cnf.xml and its signature at the TFTP root.
        # Publish the verified signature first, then the EXACT XML it signs.
        # Never sign stale root XML while a newer configuration sits in settings.
        os.chmod(signed, 0o644)
        os.chmod(source, 0o644)
        # Root creates the staging copy. Make the published unsigned XML
        # writable by FreePBX's asterisk process after atomic replacement.
        service = pwd.getpwnam('asterisk')
        os.chown(source, service.pw_uid, service.pw_gid)
        os.replace(signed, target)
        os.replace(source, TFTP / xml.name)
    print("Signed", device)



def sign_content(kind):
    """Sign Cisco media catalogs and their binary assets for ITL-trusted phones.

    Only fixed TFTP directories and narrowly whitelisted generated filenames
    are allowed. No path, certificate, filename or shell command comes from
    the web request. Use the existing TFTP signer key; never modify an ITL.
    """
    if kind == "wallpapers":
        directory = TFTP / "Desktops" / "320x212x16"
        index = "List.xml"
        expression = re.compile(r"(?:PC|TN-PC)-[0-9a-f]{16}\.png\Z")
        limit = 2500000
    elif kind == "ringtones":
        directory = TFTP
        index = "ringlist.xml"
        expression = re.compile(r"PC-[0-9a-f]{16}\.raw\Z")
        limit = 300000
    else:
        raise ValueError("Unsupported phone content kind")
    if not TFTP.is_dir() or TFTP.is_symlink():
        raise RuntimeError("Unsafe TFTP root")
    if not directory.is_dir() or directory.is_symlink():
        raise RuntimeError("Missing or unsafe content directory")
    signer = KEY_DIR / "tftp.pem"
    if not signer.is_file() or signer.is_symlink():
        raise RuntimeError("Managed TFTP signing certificate is missing")
    files = [directory / index]
    if not files[0].is_file() or files[0].is_symlink():
        raise RuntimeError("Missing or unsafe Cisco content index")
    for path in directory.iterdir():
        if expression.fullmatch(path.name):
            if not path.is_file() or path.is_symlink():
                raise RuntimeError("Unsafe Cisco media file: " + path.name)
            files.append(path)
    if len(files) > 102:
        raise RuntimeError("Too many media files to sign")

    # Stage all signatures with the same protected signer and verify them
    # before publishing. The phone may immediately fetch an individual .sgn.
    with tempfile.TemporaryDirectory(prefix=".sccp-content-", dir=str(TFTP)) as tmp:
        stage = Path(tmp)
        for source in files:
            if source.stat().st_size > limit or source.stat().st_size == 0:
                raise RuntimeError("Invalid Cisco content file size: " + source.name)
            copy = stage / source.name
            shutil.copyfile(source, copy)
            # The signed header filename must match the exact path the
            # firmware requested. For wallpapers this includes Desktops/
            # 320x212x16/; a basename-only signature downloads successfully
            # but is rejected before the phone requests any thumbnails.
            requested_name = (source.relative_to(TFTP).as_posix() + ".sgn")
            run([str(BIN_DIR / "sgnfile"), "--build", str(copy),
                 "--tftp", str(signer), "--filename", requested_name])
            signed = stage / (source.name + ".sgn")
            if not signed.is_file() or signed.stat().st_size == 0:
                raise RuntimeError("Media signing failed: " + source.name)
            output = run([str(BIN_DIR / "sgnfile"), "--parse", str(signed),
                          "--tftp", str(signer)]).stdout
            if "Valid signature" not in output:
                raise RuntimeError("Media signature verification failed: " + source.name)
            if ("Filename:         " + requested_name) not in output:
                raise RuntimeError("Cisco signed media filename does not match TFTP path: " + requested_name)

        # Publish the binary and its signature together: signed bytes must
        # match exactly the PNG or XML that TFTP is already serving.
        for source in files:
            signed = stage / (source.name + ".sgn")
            target = source.with_name(source.name + ".sgn")
            if target.is_symlink():
                raise RuntimeError("Refusing symlinked media signature: " + source.name)
            os.chmod(signed, 0o644)
            os.replace(signed, target)
    print("Signed Cisco content:", kind, len(files), "files")

def read_accounts():
    """Return account metadata without returning password hashes."""
    if ACCOUNT_PATH.is_symlink():
        raise RuntimeError("Unsafe VPN password file")
    if not ACCOUNT_PATH.is_file():
        return []
    accounts = []
    for line in ACCOUNT_PATH.read_text(encoding="utf-8").splitlines():
        if not line or line.startswith("#"):
            continue
        fields = line.split(":", 2)
        if len(fields) != 3:
            raise RuntimeError("Invalid VPN password file entry")
        username, group, encoded = fields
        if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", username):
            raise RuntimeError("Invalid VPN account name in password file")
        accounts.append({
            "username": username,
            "group": group,
            "enabled": bool(encoded and not encoded.startswith(("!", "*"))),
            "password_set": bool(encoded and not encoded.startswith(("!", "*")))
        })
    return accounts


def connected_sessions():
    """Read only the SCCP Manager instance via its own control socket."""
    occtl = shutil.which("occtl")
    if not occtl:
        return None
    try:
        result = subprocess.run([occtl, "-s", OCCTL_SOCKET, "--json", "show", "users"],
                                capture_output=True, text=True, timeout=4, check=True)
        users = json.loads(result.stdout)
        if not isinstance(users, list):
            return None
        return [{
            "username": str(entry.get("Username", ""))[:64],
            "remote_ip": str(entry.get("Remote IP", ""))[:128],
            "vpn_ip": str(entry.get("IPv4", ""))[:128],
            "connected_at": str(entry.get("_Connected at", ""))[:100]
        } for entry in users if isinstance(entry, dict)][:100]
    except (OSError, ValueError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return None


def recent_connection_events():
    """Show recent VPN connection and authentication events in the web UI."""
    try:
        result = subprocess.run(
            ["journalctl", "-u", SYSTEMD_SERVICE, "--since", "2 hours ago",
             "-n", "80", "--no-pager", "-o", "short-iso"],
            capture_output=True, text=True, timeout=4, check=True)
        markers = ("auth", "login", "connect", "session", "cisco",
                   "fail", "error", "denied", "cookie", "worker")
        return [line[:400] for line in result.stdout.splitlines()
                if any(word in line.lower() for word in markers)][-25:]
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return []


def ocserv_version():
    """Report the running VPN server binary, not only the installed package."""
    binary = ""
    try:
        result = subprocess.run(
            ["systemctl", "show", SYSTEMD_SERVICE, "--property=MainPID", "--value"],
            capture_output=True, text=True, timeout=3, check=True)
        pid = int(result.stdout.strip())
        if pid > 0:
            binary = os.readlink("/proc/{}/exe".format(pid)).replace(" (deleted)", "")
    except (OSError, ValueError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        pass
    if not binary:
        binary = next((p for p in ("/usr/local/sbin/ocserv", "/usr/sbin/ocserv")
                       if Path(p).is_file()), "")
    version = ""
    if binary:
        try:
            output = subprocess.run([binary, "--version"], capture_output=True,
                                    text=True, timeout=3, check=True)
            match = re.search(r"(\d+)\.(\d+)\.(\d+)",
                              output.stdout + output.stderr)
            if match:
                version = ".".join(match.groups())
        except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
            pass
    return binary, version


def status():
    try:
        result = subprocess.run(["systemctl", "is-active", SYSTEMD_SERVICE],
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                text=True, timeout=5)
        service = result.stdout.strip() or "unknown"
    except (OSError, subprocess.TimeoutExpired):
        service = "unknown"
    running_binary, running_version = ocserv_version()
    payload = {
        "ocserv_running_binary": running_binary,
        "ocserv_version": running_version,
        "cisco_svc_supported": bool(running_version and
                                    tuple(int(i) for i in running_version.split(".")) >= (1, 2, 0)),
        "service": service,
        "ocserv_binary": str(Path("/usr/local/sbin/ocserv")) if
                         Path("/usr/local/sbin/ocserv").is_file() else
                         shutil.which("ocserv") or "",
        "vpn_configuration_exists": MANAGED_CONFIG.is_file(),
        "server_certificate_exists": VPN_CERT.is_file(),
        "sast_certificate_exists": (KEY_DIR / "sast.pem").is_file(),
        "tftp_certificate_exists": (KEY_DIR / "tftp.pem").is_file(),
        "signing_tools_installed": all((BIN_DIR / f).is_file() for f in ("sgnfile", "tlvfile")),
        "server_setup_installed": Path(MANAGED_SETUP).is_file()
    }
    try:
        payload["accounts"] = read_accounts()
    except (OSError, ValueError, RuntimeError) as exc:
        payload["accounts"] = []
        payload["accounts_error"] = str(exc)
    payload["sessions"] = connected_sessions() if service == "active" else []
    payload["recent_events"] = recent_connection_events()
    print(json.dumps(payload))


def start_service():
    run(["systemctl", "enable", "--now", SYSTEMD_SERVICE])
    print("Service enabled and started")


def set_account(username):
    # Change only this one VPN login; password arrives via stdin, not argv.
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", username):
        raise ValueError("Invalid VPN username")
    config = MANAGED_CONFIG.read_text(encoding="utf-8")
    expected = 'auth = "plain[passwd=/etc/ocserv/ocpasswd]"'
    directives = [line.strip() for line in config.splitlines()
                  if not line.lstrip().startswith("#")]
    if expected not in directives:
        raise RuntimeError("The configured ocserv password file does not match the managed file")
    password = sys.stdin.buffer.readline(1025).rstrip(b"\r\n")
    if not password or len(password) > 1024:
        raise ValueError("Password must be between 1 and 1024 bytes")
    result = subprocess.run(["/usr/bin/openssl", "passwd", "-6", "-stdin"],
                            input=password + b"\n", capture_output=True, check=True)
    encoded = result.stdout.decode("ascii").strip()
    if not encoded.startswith("$6$"):
        raise RuntimeError("OpenSSL returned an unexpected password hash")
    target = ACCOUNT_PATH
    if target.is_symlink():
        raise RuntimeError("Refusing to replace a symlinked password file")
    entries = target.read_text().splitlines() if target.is_file() else []
    updated = []
    found = False
    for line in entries:
        if not line or line.startswith("#"):
            updated.append(line)
            continue
        fields = line.split(":", 2)
        if len(fields) != 3:
            raise RuntimeError("Unrecognized ocpasswd entry")
        if fields[0] == username:
            updated.append(username + ":" + fields[1] + ":" + encoded)
            found = True
        else:
            updated.append(line)
    if not found:
        updated.append(username + "::" + encoded)
    with tempfile.NamedTemporaryFile(prefix=".sccp-ocpasswd-", dir=str(target.parent),
                                     mode="w", encoding="utf-8", delete=False) as tmp:
        temp_name = tmp.name
        tmp.write("\n".join(updated) + "\n")
    try:
        if target.is_file():
            st = target.stat()
            os.chown(temp_name, st.st_uid, st.st_gid)
            os.chmod(temp_name, stat.S_IMODE(st.st_mode) & 0o600)
        else:
            os.chmod(temp_name, 0o600)
        os.replace(temp_name, target)
    finally:
        if os.path.exists(temp_name):
            os.unlink(temp_name)
    print("VPN login updated:", username)


def delete_account(username):
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", username):
        raise ValueError("Invalid VPN username")
    if ACCOUNT_PATH.is_symlink() or not ACCOUNT_PATH.is_file():
        raise RuntimeError("VPN password file is missing or unsafe")
    entries = ACCOUNT_PATH.read_text(encoding="utf-8").splitlines()
    kept = []
    found = False
    for line in entries:
        if not line or line.startswith("#"):
            kept.append(line)
            continue
        fields = line.split(":", 2)
        if len(fields) != 3:
            raise RuntimeError("Unrecognized ocpasswd entry")
        if fields[0] == username:
            found = True
        else:
            kept.append(line)
    if not found:
        raise ValueError("VPN account not found")
    with tempfile.NamedTemporaryFile(prefix=".sccp-ocpasswd-",
                                     dir=str(ACCOUNT_PATH.parent), mode="w",
                                     encoding="utf-8", delete=False) as tmp:
        filename = tmp.name
        tmp.write("\n".join(kept) + ("\n" if kept else ""))
    try:
        original = ACCOUNT_PATH.stat()
        os.chown(filename, original.st_uid, original.st_gid)
        os.chmod(filename, stat.S_IMODE(original.st_mode) & 0o600)
        os.replace(filename, ACCOUNT_PATH)
    finally:
        if os.path.exists(filename):
            os.unlink(filename)
    print("VPN account deleted:", username)


def configure_server():
    request = sys.stdin.buffer.read(4097)
    if len(request) > 4096:
        raise ValueError("VPN setup request is too large")
    result = subprocess.run(["/usr/bin/python3", MANAGED_SETUP], input=request,
                            capture_output=True, check=True)
    print(result.stdout.decode("utf-8").strip())


def main():
    if os.geteuid() != 0:
        raise PermissionError("This helper must run as root")
    if len(sys.argv) == 2 and sys.argv[1] == "hash":
        certificate_hash()
    elif len(sys.argv) == 2 and sys.argv[1] == "status":
        status()
    elif len(sys.argv) == 2 and sys.argv[1] == "start":
        start_service()
    elif len(sys.argv) == 2 and sys.argv[1] == "configure":
        configure_server()
    elif len(sys.argv) in (3, 4) and sys.argv[1] == "sign":
        sign(sys.argv[2], sys.argv[3] if len(sys.argv) == 4 else "")
    elif len(sys.argv) == 3 and sys.argv[1] == "sign-content":
        sign_content(sys.argv[2])
    elif len(sys.argv) == 3 and sys.argv[1] == "set-account":
        set_account(sys.argv[2])
    elif len(sys.argv) == 3 and sys.argv[1] == "delete-account":
        delete_account(sys.argv[2])
    else:
        raise ValueError("Usage: helper hash|status|start|configure|sign DEVICE [TFTP_SUBDIR]|sign-content wallpapers|ringtones|set-account USER|delete-account USER")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as exc:
        print("sccp-manager-vpn-helper: " + str(exc), file=sys.stderr)
        sys.exit(1)
